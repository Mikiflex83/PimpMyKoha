rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accessPath() { return /databases/$(database)/documents/collections_tree_access/$(request.auth.uid); }
    function member() { return signedIn() && exists(accessPath()) && get(accessPath()).data.approved == true && get(accessPath()).data.role in ['member','admin']; }
    function admin() { return member() && get(accessPath()).data.role == 'admin'; }
    match /collections_tree_access/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false && request.resource.data.role == 'pending';
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /treeData/{id} { allow read: if member(); allow create, update, delete: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
