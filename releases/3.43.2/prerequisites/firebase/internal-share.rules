{
  "rules": {
    "internal_share_access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('approved').val() === false && newData.child('role').val() === 'pending'"
      }
    },
    "shares": {
      ".read": "auth != null && root.child('internal_share_access').child(auth.uid).child('approved').val() === true",
      ".write": "auth != null && root.child('internal_share_access').child(auth.uid).child('approved').val() === true",
      ".indexOn": ["timestamp"]
    },
    "stats": {
      ".read": "auth != null && root.child('internal_share_access').child(auth.uid).child('approved').val() === true",
      ".write": "auth != null && root.child('internal_share_access').child(auth.uid).child('approved').val() === true"
    },
    ".read": false,
    ".write": false
  }
}
